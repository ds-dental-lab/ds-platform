{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_real_side.py\"",
            "timeout": 10,
            "statusMessage": "실제 쪽 보호 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/skill/build_denflow_skill.py\" --hook",
            "timeout": 30,
            "statusMessage": "DenFlow 스킬 기록 맞추기"
          }
        ]
      }
    ]
  }
}
